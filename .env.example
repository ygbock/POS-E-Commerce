# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Standard PostgreSQL connection string for production persistence.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
# If omitted or running in local dev/test without external DB, AbaCha automatically
# boots an isolated embedded PostgreSQL engine (PGlite) storing state in .data/postgres.
DATABASE_URL=

# Explicit PostgreSQL Connection Parameters (alternative to DATABASE_URL)
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=require

# JWT Authentication Configuration (SEC-001)
# Production MUST supply a cryptographically secure, high-entropy secret (min 32 bytes).
# Example: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=900

# Authentication security boundaries (staging/production)
# 32-byte base64 or 64-character hex key. Never reuse across environments.
MFA_ENCRYPTION_KEY=
# HTTPS application URL used by password reset links.
PASSWORD_RESET_URL=
# Set only when a real approved delivery provider is wired into the application.
EMAIL_VERIFICATION_DELIVERY_CONFIGURED=false
PASSWORD_RESET_DELIVERY_CONFIGURED=false
# Number of trusted reverse-proxy hops. Production/staging default to 1.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Server-side development seed credentials for platform control-plane identities.
# SYSTEM OWNER is opt-in: if its password is blank, no system-owner seed account is created.
ABACHA_SYSTEM_OWNER_EMAIL=systemowner@abacha.internal
ABACHA_SYSTEM_OWNER_PASSWORD=

# Platform administrator seed credentials.
# Set these in your local .env / deployment secret store; never commit the real password.
# Re-run the development seed after changing either value.
ABACHA_PLATFORM_ADMIN_EMAIL=platformadmin@abacha.internal
ABACHA_PLATFORM_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Development-only persona switcher credentials
# ---------------------------------------------------------------------------
# These values are intentionally blank in source control.
# loginAsPersona() only reads them when Vite is running in DEV mode.
# Never place real production credentials in VITE_* variables or commit them.
VITE_DEMO_SUPER_ADMIN_EMAIL=
VITE_DEMO_SUPER_ADMIN_PASSWORD=
VITE_DEMO_BUSINESS_OWNER_EMAIL=
VITE_DEMO_BUSINESS_OWNER_PASSWORD=
VITE_DEMO_STORE_MANAGER_EMAIL=
VITE_DEMO_STORE_MANAGER_PASSWORD=
VITE_DEMO_CASHIER_EMAIL=
VITE_DEMO_CASHIER_PASSWORD=
VITE_DEMO_INVENTORY_MANAGER_EMAIL=
VITE_DEMO_INVENTORY_MANAGER_PASSWORD=
VITE_DEMO_WAREHOUSE_MANAGER_EMAIL=
VITE_DEMO_WAREHOUSE_MANAGER_PASSWORD=
VITE_DEMO_ACCOUNTANT_EMAIL=
VITE_DEMO_ACCOUNTANT_PASSWORD=
VITE_DEMO_ECOMMERCE_CUSTOMER_EMAIL=
VITE_DEMO_ECOMMERCE_CUSTOMER_PASSWORD=
VITE_DEMO_SYSTEM_OWNER_EMAIL=owner_email@abacha.com
VITE_DEMO_SYSTEM_OWNER_PASSWORD=ownerpassword123
VITE_DEMO_PLATFORM_ADMIN_EMAIL=
VITE_DEMO_PLATFORM_ADMIN_PASSWORD=
VITE_DEMO_PLATFORM_SUPPORT_EMAIL=
VITE_DEMO_PLATFORM_SUPPORT_PASSWORD=
VITE_DEMO_PLATFORM_FINANCE_EMAIL=
VITE_DEMO_PLATFORM_FINANCE_PASSWORD=
