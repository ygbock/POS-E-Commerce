# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Standard PostgreSQL connection string for production persistence.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
# If omitted or running in local dev/test without external DB, AbaCha automatically
# boots an isolated embedded PostgreSQL engine (PGlite) storing state in .data/postgres.
DATABASE_URL=

# Explicit PostgreSQL Connection Parameters (alternative to DATABASE_URL)
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=require

# JWT Authentication Configuration (SEC-001)
# Production MUST supply a cryptographically secure, high-entropy secret (min 32 bytes).
# Example: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=86400

# ---------------------------------------------------------------------------
# Development-only persona switcher credentials
# ---------------------------------------------------------------------------
# These values are intentionally blank in source control.
# loginAsPersona() only reads them when Vite is running in DEV mode.
# Never place real production credentials in VITE_* variables or commit them.
VITE_DEMO_SUPER_ADMIN_EMAIL=
VITE_DEMO_SUPER_ADMIN_PASSWORD=
VITE_DEMO_BUSINESS_OWNER_EMAIL=
VITE_DEMO_BUSINESS_OWNER_PASSWORD=
VITE_DEMO_STORE_MANAGER_EMAIL=
VITE_DEMO_STORE_MANAGER_PASSWORD=
VITE_DEMO_CASHIER_EMAIL=
VITE_DEMO_CASHIER_PASSWORD=
VITE_DEMO_INVENTORY_MANAGER_EMAIL=
VITE_DEMO_INVENTORY_MANAGER_PASSWORD=
VITE_DEMO_WAREHOUSE_MANAGER_EMAIL=
VITE_DEMO_WAREHOUSE_MANAGER_PASSWORD=
VITE_DEMO_ACCOUNTANT_EMAIL=
VITE_DEMO_ACCOUNTANT_PASSWORD=
VITE_DEMO_ECOMMERCE_CUSTOMER_EMAIL=
VITE_DEMO_ECOMMERCE_CUSTOMER_PASSWORD=
VITE_DEMO_SYSTEM_OWNER_EMAIL=
VITE_DEMO_SYSTEM_OWNER_PASSWORD=
VITE_DEMO_PLATFORM_ADMIN_EMAIL=
VITE_DEMO_PLATFORM_ADMIN_PASSWORD=
VITE_DEMO_PLATFORM_SUPPORT_EMAIL=
VITE_DEMO_PLATFORM_SUPPORT_PASSWORD=
VITE_DEMO_PLATFORM_FINANCE_EMAIL=
VITE_DEMO_PLATFORM_FINANCE_PASSWORD=
