    "test:platform-subscriptions": "tsx tests/platform_subscription_management.test.ts",
    "test:discovery-search": "tsx tests/discovery_search.test.ts && tsx tests/discovery_search_ranking.test.ts && tsx tests/discovery_search_attribution.test.ts",
    "test:discovery-trust": "tsx tests/discovery_trust_workflow.test.ts",
    "test:discovery-merchant-trust": "tsx tests/discovery_merchant_trust.test.ts",
    "test:discovery-favorites": "tsx tests/discovery_customer_favorites.test.ts",
    "test:discovery-contact": "tsx tests/discovery_contact_inquiries.test.ts",
    "test:discovery-review-responses": "tsx tests/discovery_review_responses.test.ts",
    "test:discovery-category-governance": "tsx tests/discovery_category_governance.test.ts",
    "test:discovery-location-quality": "tsx tests/discovery_location_quality.test.ts",
    "test:discovery-service-matching": "tsx tests/discovery_service_matching.test.ts",
    "test:discovery-performance": "tsx tests/discovery_performance.test.ts",
    "test:discovery-search-attribution": "tsx tests/discovery_search_attribution.test.ts",
    "test:merchant-owner": "tsx tests/merchant_owner_signup.test.ts",
    "test:discovery-permissions": "tsx tests/discovery_business_permissions.test.ts",
    "test:discovery-authorization": "tsx tests/discovery_business_authorization.test.ts",
    "test:discovery-moderation": "tsx tests/discovery_moderation_authorization.test.ts",
    "test:discovery-http-authorization": "tsx tests/discovery_business_http_authorization.test.ts",
    "test:discovery-audit": "tsx tests/discovery_audit_logging.test.ts"
