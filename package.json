    "test": "npm run test:db && npm run test:platform && npm run test:subscription-foundation && npm run test:subscription-limits && npm run test:platform-subscriptions && npm run test:tenant-provisioning && npm run test:security && npm run test:inventory && npm run test:transfer && npm run test:pos && npm run test:api && npm run test:qa && npm run test:ux && npm run test:checkout && npm run test:offline-pos && npm run test:prod-gate && npm run test:operational && npm run test:storefront && npm run test:storefront-modernization && npm run test:storefront-api && npm run test:storefront-router && npm run test:storefront-catalog && npm run test:tenant-business-plane && npm run test:audit && npm run test:discovery && npm run test:discovery-search",
    "test:coverage": "c8 --all --src server --lines 70 --branches 60 --functions 75 --statements 70 --reporter=text --reporter=html npm test",
    "test:storefront-router": "tsx tests/storefront_router.test.ts",
    "test:storefront-catalog": "tsx tests/storefront_catalog.test.ts",
    "test:storefront-api": "tsx tests/storefront_api_client.test.ts",
    "test:tenant-business-plane": "tsx tests/tenant_business_plane.test.ts",
    "test:subscription-foundation": "tsx tests/subscription_foundation.test.ts",
    "test:subscription-limits": "tsx tests/subscription_limits.test.ts",
