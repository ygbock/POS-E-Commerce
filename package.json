{
  "name": "abacha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx server/db/migrator.ts",
    "db:seed": "tsx server/db/migrator.ts --with-seed",
    "seed:dev": "tsx server/db/seeds/dev_seed.ts",
    "test:db": "tsx tests/persistence.test.ts",
    "test:auth": "tsx tests/auth_security.test.ts",
    "test:security": "tsx tests/auth_security.test.ts",
    "test:inventory": "tsx tests/inventory.test.ts",
    "test:transfer": "tsx tests/transfer.test.ts",
    "test:pos": "tsx tests/pos.test.ts",
    "test:api": "tsx tests/api_hardening.test.ts",
    "test:qa": "tsx tests/qa_verification.test.ts",
    "test:ux": "tsx tests/ux_accessibility.test.ts && tsx tests/ux_pos_hotkeys.test.ts",
    "test:hotkeys": "tsx tests/ux_pos_hotkeys.test.ts",
    "test:checkout": "tsx tests/ux_storefront_checkout_integrity.test.ts",
    "test:offline-pos": "tsx tests/ux_offline_pos.test.ts",
    "test:prod-gate": "tsx tests/production_gate.test.ts",
    "test:operational": "tsx tests/operational_hardening.test.ts",
    "test:storefront": "tsx tests/storefront_multi_tenant.test.ts",
    "test": "npm run test:db && npm run test:security && npm run test:inventory && npm run test:transfer && npm run test:pos && npm run test:api && npm run test:qa && npm run test:ux && npm run test:checkout && npm run test:offline-pos && npm run test:prod-gate && npm run test:operational && npm run test:storefront && npm run test:storefront-api && npm run test:storefront-router",
    "test:coverage": "c8 --all --src server --lines 70 --branches 60 --functions 75 --statements 70 --reporter=text --reporter=html npm test",
    "test:storefront-router": "tsx tests/storefront_router.test.ts",
    "test:storefront-api": "tsx tests/storefront_api_client.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "c8": "^12.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
